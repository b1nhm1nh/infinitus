// infinitus.run — static landing page as a Cloudflare Workers assets-only
// deploy. `npx wrangler deploy` from this directory; the custom domain
// binds automatically (zone must be on the same Cloudflare account).
{
  "name": "infinitus-run",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "infinitus.run", "custom_domain": true },
    { "pattern": "www.infinitus.run", "custom_domain": true }
  ]
}
